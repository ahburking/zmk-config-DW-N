#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEFAULT_LAYER   0
#define A_LAYER   1

/ {
    keymap {
        compatible = "zmk,keymap";

        DEFAULT_LAYER {
            bindings = <
&kp N7     &kp N8     &kp N9     &kp EQUAL           &kp C_VOLUME_UP
&kp N4     &kp N5     &kp N6     &kp MINUS           &kp C_VOLUME_DOWN
&kp N1     &kp N2     &kp N3     &kp KP_MULTIPLY     &mo 1
&kp N0     &kp RET                &kp KP_DIVIDE      &kp RSHIFT
            >;
        };

        A_LAYER {
            bindings = <
&sys_reset            &none            &none            &none     &bt BT_CLR_ALL
&none                 &none            &none            &none     &none
&bt BT_SEL 1          &bt BT_SEL 2     &bt BT_SEL 3     &none     &none
&bt BT_SEL 0          &none                             &none     &none 
            >;
        };
    };
};